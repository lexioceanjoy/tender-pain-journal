{
  "name": "tender-pain-journal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ai": "concurrently -k -n app,ai \"vite\" \"tsx watch --env-file-if-exists=.env.local server/index.ts\"",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "generate:choir": "node scripts/generate-choir-regions.mjs",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@vitejs/plugin-react": "latest",
    "dexie": "latest",
    "openai": "^7.4.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "^26.2.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "^10.0.4",
    "jsdom": "latest",
    "tsx": "^4.23.11",
    "typescript": "latest",
    "vitest": "latest"
  }
}
